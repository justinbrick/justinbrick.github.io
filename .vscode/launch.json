{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Browser",
            "request": "launch",
            "type": "firefox",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/src",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ]
        },
        {
            "name": "Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}",
            "serverReadyAction": {
                "pattern": "➜\\s+Local:\\s+(https?://\\S+)",
                "action": "startDebugging",
                "name": "Browser"
            }
        },
    ],
    "compounds": []
}