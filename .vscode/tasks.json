{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dev",
            "type": "shell",
            "command": "npm run dev",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Local|Network"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Start SvelteKit dev server with Vite HMR"
        }
    ]
}